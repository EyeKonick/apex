---
import site from '../data/site.json';

const { heading, body } = site.sections.contact;
const mailto = `mailto:${site.email}?subject=${encodeURIComponent(site.quoteEmailSubject)}`;
---
<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="copy">
    <h2 class="display" id="contact-title" data-reveal="lines">
      <span class="ln" style="--l:0"><span>{heading[0]}</span></span>
      <span class="ln" style="--l:1"><span class="hi">{heading[1]}</span></span>
    </h2>
    <p data-reveal style="--i:2">{body}</p>
    <p class="area" data-reveal style="--i:3"><svg class="ico" aria-hidden="true"><use href="#i-pin" /></svg>{site.serviceArea.label}</p>
  </div>

  <ul class="actions">
    <li data-reveal style="--i:0">
      <a class="row call sweep" href={`tel:${site.phone.tel}`}>
        <svg class="ico" aria-hidden="true"><use href="#i-phone" /></svg>
        <span><small>Call or text</small>{site.phone.display}</span>
        <svg class="ico arrow" aria-hidden="true"><use href="#i-arrow" /></svg>
      </a>
    </li>
    <li data-reveal style="--i:1">
      <a class="row sweep" href={mailto}>
        <svg class="ico" aria-hidden="true"><use href="#i-mail" /></svg>
        <span><small>Email</small>{site.email}</span>
        <svg class="ico arrow" aria-hidden="true"><use href="#i-arrow" /></svg>
      </a>
    </li>
    <li data-reveal style="--i:2">
      <a class="row sweep" href={site.facebook.url} data-placeholder={site.facebook.placeholder ? site.facebook.todo : undefined}>
        <svg class="ico fill" aria-hidden="true"><use href="#i-fb" /></svg>
        <span><small>Facebook</small>Message us on Facebook</span>
        <svg class="ico arrow" aria-hidden="true"><use href="#i-arrow" /></svg>
      </a>
    </li>
  </ul>
</section>

<style>
  .contact { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 40px clamp(32px, 5vw, 80px); align-items: end; padding: clamp(72px, 12vh, 140px) var(--gutter); }
  h2 { margin-bottom: clamp(24px, 4vh, 40px); }
  .copy p { font-size: clamp(1.05rem, 1.4vw, 1.2rem); line-height: 1.55; color: var(--ink-soft); max-width: 46ch; }
  .copy .area { margin-top: 20px; display: flex; align-items: center; gap: .6em; color: var(--white); font-weight: 700; font-size: 15px; }
  .area .ico { color: var(--blue-hi); }

  .actions { list-style: none; display: grid; gap: 10px; }
  .row { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 18px; min-height: 76px; padding: 14px clamp(18px, 2.5vw, 32px); background: var(--navy-900); border: 1px solid rgba(255, 255, 255, .1); color: var(--white); text-decoration: none; font-size: 22px; --sweep: var(--blue); transition: color var(--dur-std) var(--spring-standard), border-color var(--dur-std) var(--spring-standard); }
  .row span { display: flex; flex-direction: column; gap: 2px; font-weight: 700; font-size: clamp(1rem, 1.5vw, 1.15rem); overflow-wrap: anywhere; }
  .row small { font-weight: 800; font-stretch: 112%; text-transform: uppercase; letter-spacing: .04em; font-size: 12.5px; opacity: .85; }
  .row.call { --sweep: var(--navy-800); background: var(--white); border-color: var(--white); color: var(--navy-950); }
  .row.call span { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.8rem, 2.6vw, 2.4rem); line-height: 1; letter-spacing: .01em; }
  .row.call small { font-family: var(--font-body); }
  .row:hover { border-color: var(--blue); color: var(--white); }
  .row.call:hover { border-color: var(--navy-800); color: var(--white); }
  .row .ico:first-child { color: var(--blue-hi); }
  .row.call .ico:first-child, .row:hover .ico:first-child { color: inherit; }

  @media (max-width: 900px) {
    .contact { grid-template-columns: 1fr; }
  }
</style>
