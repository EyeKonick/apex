---
import { Image } from 'astro:assets';
import site from '../data/site.json';
import services from '../data/services.json';
import { servicePhotos } from '../lib/photos';

const { heading, lede } = site.sections.services;
---
<section class="services" id="services" aria-labelledby="services-title">
  <div class="intro">
    <h2 class="display" id="services-title" data-reveal="lines">
      <span class="ln" style="--l:0"><span>{heading[0]}</span></span>
      <span class="ln" style="--l:1"><span class="hi">{heading[1]}</span></span>
    </h2>
    <p class="lede" data-reveal style="--i:2">{lede}</p>
  </div>

  <ul class="grid">
    {services.map((s, i) => {
      const photo = servicePhotos[s.id];
      return (
        <li class:list={['tile', { lead: i === 0 }]} data-reveal style={`--i:${i % 4}`}>
          {photo && (
            <figure class="shot" data-placeholder={photo.placeholder ? '' : undefined}>
              <Image
                src={photo.src}
                alt={photo.alt}
                widths={[360, 560, 800, 1100]}
                sizes={i === 0
                  ? '(max-width: 640px) 100vw, (max-width: 1100px) 92vw, 48vw'
                  : '(max-width: 640px) 100vw, (max-width: 1100px) 46vw, 24vw'}
                format="webp"
                quality={72}
              />
            </figure>
          )}
          <div class="body">
            <h3><svg class="ico" aria-hidden="true"><use href={`#i-${s.icon}`} /></svg>{s.title}</h3>
            <p>{s.description}</p>
          </div>
        </li>
      );
    })}
  </ul>
</section>

<style>
  .services { padding: clamp(72px, 12vh, 128px) var(--gutter) 0; }
  .intro { padding-bottom: clamp(32px, 5vh, 56px); display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 40ch); gap: 20px 56px; align-items: end; }
  .lede { font-size: clamp(1rem, 1.2vw, 1.1rem); line-height: 1.6; color: var(--ink-soft); }

  /* 4 columns with a wide lead tile = two full rows of seven services, no orphan */
  .grid { list-style: none; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(12px, 1.4vw, 20px); }
  .tile { display: flex; flex-direction: column; background: var(--navy-900); border: 1px solid rgba(255, 255, 255, .08); transition: border-color var(--dur-std) var(--spring-standard), transform var(--dur-std) var(--spring-standard), box-shadow var(--dur-std) var(--spring-standard); }
  .tile.lead { grid-column: span 2; }
  .tile:hover { border-color: rgba(111, 155, 255, .55); transform: translateY(-6px); box-shadow: 0 22px 40px -24px rgba(0, 0, 0, .8); }

  /* Photos sit quietly in greyscale and come into colour on hover */
  .shot { position: relative; overflow: hidden; margin: 0; height: clamp(170px, 15vw, 230px); background: var(--navy-800); }
  .shot :global(img) { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.05) brightness(.92); transition: filter var(--dur-section) var(--spring-gentle), transform var(--dur-hero) var(--spring-gentle); }
  .tile:hover .shot :global(img) { filter: none; transform: scale(1.06); }

  .body { padding: 18px 20px 22px; display: grid; gap: 8px; }
  h3 { display: flex; align-items: flex-start; gap: .55em; font-size: 1.08rem; font-weight: 650; line-height: 1.3; letter-spacing: -.005em; }
  h3 .ico { color: var(--blue-hi); font-size: 1.15em; margin-top: .05em; transition: transform var(--dur-std) var(--spring-expressive); }
  .tile:hover h3 .ico { transform: translateY(-2px) scale(1.12); }
  .body p { font-size: .95rem; line-height: 1.55; color: var(--ink-soft); padding-left: calc(1.08rem * 1.15 + .55em * 1.08); }

  @media (max-width: 1100px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .shot { height: clamp(170px, 24vw, 240px); }
  }
  @media (max-width: 860px) {
    .intro { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .grid { grid-template-columns: 1fr; }
    .tile.lead { grid-column: auto; }
    .shot { height: 52vw; }
  }
</style>
