---
import data from '../data/testimonials.json';

const { heading, lede, items } = data;
const featured = items.find((t) => t.featured) ?? items[0];
const rest = items.filter((t) => t !== featured);
const initials = (name: string) => name.split(/\s+/).map((w) => w[0]).join('').replace(/\W/g, '').slice(0, 2).toUpperCase();
---
<section class="voices" id="testimonials" aria-labelledby="voices-title">
  <div class="intro">
    <h2 class="display" id="voices-title" data-reveal="lines">
      <span class="ln" style="--l:0"><span>{heading[0]}</span></span>
      <span class="ln" style="--l:1"><span class="hi">{heading[1]}</span></span>
    </h2>
    <div class="side">
      <p class="lede" data-reveal style="--i:2">{lede}</p>
    </div>
  </div>

  <div class="grid">
    <figure class="feat" data-reveal style="--i:0">
      <span class="mark" aria-hidden="true">&ldquo;</span>
      <blockquote><p>{featured.quote}</p></blockquote>
      <figcaption>
        <span class="av" aria-hidden="true">{initials(featured.name)}</span>
        <span class="who"><strong>{featured.name}</strong>{featured.role}, {featured.location}</span>
        <span class="svc">{featured.service}</span>
      </figcaption>
    </figure>

    <ul class="list">
      {rest.map((t, i) => (
        <li data-reveal style={`--i:${i + 1}`}>
          <figure class="card">
            <blockquote><p>{t.quote}</p></blockquote>
            <figcaption>
              <span class="av" aria-hidden="true">{initials(t.name)}</span>
              <span class="who"><strong>{t.name}</strong>{t.role}, {t.location}</span>
              <span class="svc">{t.service}</span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .voices { margin-top: clamp(72px, 12vh, 140px); padding: clamp(64px, 11vh, 128px) var(--gutter); background: var(--white); color: var(--navy-950); }
  .voices :focus-visible { outline-color: var(--blue); }
  .intro { padding-bottom: clamp(32px, 5vh, 56px); display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 40ch); gap: 20px 56px; align-items: end; }
  h2 .hi { color: var(--blue); }
  .lede { font-size: clamp(1rem, 1.2vw, 1.1rem); line-height: 1.6; color: var(--navy-ink-soft); }

  .grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(12px, 1.4vw, 20px); }

  /* Featured quote: a navy plate on the white sheet */
  .feat { position: relative; overflow: hidden; margin: 0; display: flex; flex-direction: column; justify-content: space-between; gap: 40px; padding: clamp(28px, 4vw, 56px); background: var(--navy-950); color: var(--white); }
  .feat::before { content: ""; position: absolute; inset: auto 0 0 0; height: 4px; background: var(--blue); transform: scaleX(.18); transform-origin: left; transition: transform var(--dur-section) var(--spring-gentle); }
  .feat:hover::before { transform: scaleX(1); }
  .mark { font-family: var(--font-display); font-weight: 800; font-size: clamp(6rem, 11vw, 10rem); line-height: .6; height: .45em; color: var(--blue-hi); }
  .feat blockquote p { font-size: clamp(1.35rem, 2.3vw, 2.05rem); font-weight: 560; line-height: 1.3; letter-spacing: -.01em; max-width: 30ch; }
  .feat .who { color: var(--ink-soft); }
  .feat .who strong { color: var(--white); }
  .feat .av { background: var(--blue); color: var(--white); }
  .feat .svc { border-color: rgba(255, 255, 255, .3); color: var(--blue-hi); }

  .list { list-style: none; display: grid; gap: clamp(12px, 1.4vw, 20px); }
  .card { position: relative; overflow: hidden; height: 100%; margin: 0; display: flex; flex-direction: column; justify-content: space-between; gap: 22px; padding: clamp(20px, 2vw, 28px); border: 1px solid rgba(3, 12, 30, .14); background: var(--white); transition: transform var(--dur-std) var(--spring-standard), box-shadow var(--dur-std) var(--spring-standard), border-color var(--dur-std) var(--spring-standard); }
  .card:hover { transform: translateY(-4px); box-shadow: 0 22px 40px -28px rgba(3, 12, 30, .55); border-color: rgba(3, 12, 30, .28); }
  /* Same rule as the featured plate: a short blue bar along the foot that runs full width on hover */
  .card::after { content: ""; position: absolute; inset: auto 0 0 0; height: 3px; background: var(--blue); transform: scaleX(.12); transform-origin: left; transition: transform var(--dur-section) var(--spring-gentle); }
  .card:hover::after { transform: scaleX(1); }
  .card blockquote p { font-size: 1.02rem; line-height: 1.55; color: var(--navy-950); }

  figcaption { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 12px; }
  .av { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--navy-950); color: var(--white); font-weight: 800; font-stretch: 112%; font-size: 13px; letter-spacing: .04em; }
  .who { display: flex; flex-direction: column; gap: 1px; font-size: 13.5px; line-height: 1.35; color: var(--navy-ink-soft); }
  .who strong { font-size: 15px; color: var(--navy-950); }
  .svc { padding: 5px 9px; border: 1px solid rgba(3, 12, 30, .2); color: var(--blue); font-weight: 800; font-stretch: 112%; text-transform: uppercase; letter-spacing: .04em; font-size: 11px; white-space: nowrap; }

  @media (max-width: 1000px) {
    .grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 860px) {
    .intro { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    figcaption { grid-template-columns: auto minmax(0, 1fr); }
    .svc { grid-column: 1 / -1; justify-self: start; }
  }
</style>
