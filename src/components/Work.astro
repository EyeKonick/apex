---
import { Image } from 'astro:assets';
import work from '../data/work.json';
import { workPhotos } from '../lib/photos';

const { heading, lede, projects } = work;
---
<section class="work" id="work" aria-labelledby="work-title">
  <div class="intro">
    <h2 class="display" id="work-title" data-reveal="lines">
      <span class="ln" style="--l:0"><span>{heading[0]}</span></span>
      <span class="ln" style="--l:1"><span class="hi">{heading[1]}</span></span>
    </h2>
    <div class="side">
      <p class="lede" data-reveal style="--i:2">{lede}</p>
    </div>
  </div>

  <ol class="grid">
    {projects.map((p, i) => {
      const photo = workPhotos[p.id];
      return (
        <li class={`card c${i + 1}`} data-reveal style={`--i:${i % 3}`}>
          {photo && (
            <figure class="shot" data-placeholder={photo.placeholder ? '' : undefined}>
              <Image
                src={photo.src}
                alt={photo.alt}
                widths={[420, 640, 900, 1300]}
                sizes={i === 0
                  ? '(max-width: 760px) 100vw, (max-width: 1100px) 92vw, 56vw'
                  : '(max-width: 760px) 100vw, (max-width: 1100px) 46vw, 40vw'}
                format="webp"
                quality={72}
              />
            </figure>
          )}
          <div class="meta">
            <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <ul class="tags" aria-label="Trades">
              {p.trades.map((t) => <li>{t}</li>)}
            </ul>
          </div>
          <div class="body">
            <h3>{p.title}</h3>
            <p class="scope">{p.scope}</p>
            <p class="loc"><svg class="ico" aria-hidden="true"><use href="#i-pin" /></svg>{p.location}</p>
          </div>
        </li>
      );
    })}
  </ol>
</section>

<style>
  .work { padding: clamp(72px, 12vh, 140px) var(--gutter) 0; }
  .intro { padding-bottom: clamp(32px, 5vh, 56px); display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 40ch); gap: 20px 56px; align-items: end; }
  .lede { font-size: clamp(1rem, 1.2vw, 1.1rem); line-height: 1.6; color: var(--ink-soft); }

  /* Editorial bento: a tall lead project, two stacked beside it, then a wide pair below */
  .grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: clamp(240px, 22vw, 320px);
    gap: clamp(12px, 1.4vw, 20px);
  }
  .c1 { grid-column: span 7; grid-row: span 2; }
  .c2, .c3 { grid-column: span 5; }
  .c4 { grid-column: span 5; }
  .c5 { grid-column: span 7; }

  .card { position: relative; overflow: hidden; isolation: isolate; background: var(--navy-900); border: 1px solid rgba(255, 255, 255, .08); transition: border-color var(--dur-std) var(--spring-standard); }
  .card:hover { border-color: rgba(111, 155, 255, .55); }

  .shot { position: absolute; inset: 0; z-index: -2; margin: 0; background: var(--navy-800); }
  .shot :global(img) { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.08) brightness(1); transition: filter var(--dur-section) var(--spring-gentle), transform var(--dur-hero) var(--spring-gentle); }
  .card:hover .shot :global(img) { filter: none; transform: scale(1.05); }
  /* Navy scrim so copy always reads, heavier at the foot */
  .card::after { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(3, 12, 30, .55) 0%, rgba(3, 12, 30, 0) 30%, rgba(3, 12, 30, .25) 55%, rgba(3, 12, 30, .94) 100%); }

  .meta { position: absolute; inset: 0 0 auto; display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; padding: clamp(16px, 1.6vw, 24px); }
  .num { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.6rem, 2.2vw, 2.2rem); line-height: 1; color: var(--white); }
  .tags { list-style: none; display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 6px; }
  .tags li { padding: 5px 10px; background: var(--blue); color: var(--white); font-weight: 800; font-stretch: 112%; text-transform: uppercase; letter-spacing: .04em; font-size: 11.5px; }

  .body { position: absolute; inset: auto 0 0; display: grid; gap: 8px; padding: clamp(18px, 2vw, 28px); }
  h3 { font-size: clamp(1.1rem, 1.5vw, 1.35rem); font-weight: 700; line-height: 1.25; letter-spacing: -.005em; max-width: 30ch; }
  .c1 h3 { font-family: var(--font-display); font-weight: 800; text-transform: uppercase; font-size: clamp(1.8rem, 3vw, 2.8rem); line-height: .95; letter-spacing: 0; max-width: 16ch; }
  .scope { font-size: .95rem; line-height: 1.5; color: var(--ink-soft); max-width: 46ch; }
  /* Secondary detail slides in on hover for pointer devices; always shown on touch */
  @media (hover: hover) {
    .card:not(.c1) .scope { max-height: 0; opacity: 0; overflow: hidden; transition: max-height var(--dur-section) var(--spring-gentle), opacity var(--dur-std) ease; }
    .card:not(.c1):hover .scope { max-height: 6em; opacity: 1; }
  }
  .loc { display: flex; align-items: center; gap: .5em; font-size: 13.5px; font-weight: 700; color: var(--white); }
  .loc .ico { color: var(--blue-hi); }

  @media (max-width: 1100px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: clamp(260px, 38vw, 340px); }
    .c1 { grid-column: span 2; grid-row: span 1; min-height: clamp(320px, 52vw, 460px); }
    .c2, .c3, .c4, .c5 { grid-column: span 1; }
  }
  @media (max-width: 860px) {
    .intro { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .grid { grid-template-columns: 1fr; grid-auto-rows: auto; }
    .card, .c1 { grid-column: auto; min-height: 88vw; }
    .c1 { min-height: 110vw; }
  }
</style>
